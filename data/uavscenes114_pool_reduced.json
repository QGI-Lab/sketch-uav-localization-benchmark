{
 "note": "Pool of 114 drone-to-orthophoto pairs drawn from UAVScenes at a uniform stride in reference-position space, so that pair selection does not depend on whether any matcher succeeds. UAVScenes ships no overhead map, so the map side of every pair here is rendered from the public Esri World Imagery tile service. Two flights (amvalley01, hkisland01) use a LiDAR-orthorectified render, marked render=ortho3; the others use a flat-ground render, marked render=flat. Reduced for public release: the three local cache directory fields (npz_dir, prepack_dir, orthos_dir) were removed. Resolve each pair against the public UAVScenes release using 'flight' and 'frame_idx'. See the README for the tile service URL and terms.",
 "n_total": 114,
 "fields": {
  "pair": "pair identifier, also the pid used in every result row",
  "flight": "UAVScenes sequence name",
  "terrain": "terrain class used for the per-terrain tables",
  "label_source": "how the reference position for this pair was derived",
  "render": "flat = flat-ground map render; ortho = LiDAR-orthorectified render",
  "gt_derived": "true means the reference position was used to place the pair, never inside a matcher",
  "frame_idx": "frame index within the flight",
  "budget_drone": "ground sampling distance of the drone crop, metres per pixel",
  "budget_win": "ground sampling distance of the search window, metres per pixel",
  "budget_ortho": "ground sampling distance of the map render, metres per pixel"
 },
